---
import Base from '../layouts/Base.astro'
---

<Base title="페이지를 찾을 수 없습니다">
  <section>
    <h1>페이지를 찾을 수 없습니다</h1>
    <p>주소가 바뀌었거나 삭제된 글일 수 있습니다.</p>
    <a href="/">공지사항으로 돌아가기</a>
  </section>
</Base>

<style>
  section {
    padding: 80px 0;
    text-align: center;
  }

  h1 {
    margin: 0 0 12px;
    font-size: 22px;
  }

  p {
    margin: 0 0 24px;
    color: #6b7684;
  }

  a {
    color: #b40407;
    font-weight: 600;
    text-decoration: none;
  }
</style>
