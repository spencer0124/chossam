---
/**
 * One notice. Built for every synced post; nothing is fetched at request time.
 */
import { getCollection, render, type CollectionEntry } from 'astro:content'
import Base from '../../layouts/Base.astro'
import { formatKoreanDate } from '../../lib/date'

export async function getStaticPaths() {
  const posts = await getCollection('posts')
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }))
}

// Declared rather than inferred from getStaticPaths: annotating that function
// with `GetStaticPaths` widens the props back to `unknown`.
type Props = { post: CollectionEntry<'posts'> }

const { post } = Astro.props
const { Content } = await render(post)
---

<Base title={post.data.title}>
  <article>
    <nav class="back">
      <a href={`/?board=${encodeURIComponent(post.data.board)}`}>← {post.data.board}</a>
    </nav>

    <header>
      <h1>{post.data.title}</h1>
      {
        post.data.date && (
          <time datetime={post.data.date}>{formatKoreanDate(post.data.date)}</time>
        )
      }
    </header>

    <div class="body">
      <Content />
    </div>
  </article>
</Base>

<style>
  .back {
    padding: 24px 0 8px;
    font-size: 14px;
  }

  .back a {
    color: #6b7684;
    text-decoration: none;
  }

  header {
    padding-bottom: 20px;
    border-bottom: 1px solid #e5e8eb;
  }

  h1 {
    margin: 0 0 8px;
    font-size: 26px;
    line-height: 1.4;
    letter-spacing: -0.02em;
  }

  time {
    color: #8b95a1;
    font-size: 14px;
  }

  .body {
    padding-top: 28px;
    font-size: 16px;
    line-height: 1.75;
    color: #333d4b;
  }

  .body :global(p) {
    margin: 0 0 18px;
  }

  .body :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 24px 0;
    border-radius: 8px;
  }

  .body :global(h1),
  .body :global(h2),
  .body :global(h3) {
    margin: 32px 0 12px;
    line-height: 1.4;
    color: #191f28;
  }

  .body :global(h1) { font-size: 22px; }
  .body :global(h2) { font-size: 19px; }
  .body :global(h3) { font-size: 17px; }

  .body :global(strong) {
    font-weight: 700;
    color: #191f28;
  }

  .body :global(ul),
  .body :global(ol) {
    margin: 0 0 18px;
    padding-left: 22px;
  }

  .body :global(li) {
    margin: 4px 0;
  }

  .body :global(li::marker) {
    color: #8b95a1;
  }

  /* Notion quote blocks arrive as blockquotes; a left rule in the brand red
     keeps them recognisable without a heavy card. */
  .body :global(blockquote) {
    margin: 24px 0;
    padding: 4px 0 4px 16px;
    border-left: 3px solid #b40407;
    color: #4e5968;
  }

  .body :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .body :global(hr) {
    margin: 32px 0;
    border: none;
    border-top: 1px solid #e5e8eb;
  }

  .body :global(a) {
    color: #b40407;
  }

  .body :global(code) {
    padding: 2px 5px;
    border-radius: 4px;
    background: #f2f4f6;
    font-size: 14px;
  }

  .body :global(pre) {
    margin: 24px 0;
    padding: 16px;
    border-radius: 8px;
    background: #f9fafb;
    overflow-x: auto;
  }

  .body :global(table) {
    width: 100%;
    margin: 24px 0;
    border-collapse: collapse;
    font-size: 15px;
  }

  .body :global(th),
  .body :global(td) {
    padding: 10px 12px;
    border: 1px solid #e5e8eb;
    text-align: left;
  }
</style>
